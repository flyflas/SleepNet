DATA_ROOT="/Users/xiaobai/Documents/model"

MLFLOW_TRACKING_URI="http://YOUR_SERVER_IP:5000"
MLFLOW_TRACKING_USERNAME="admin"
MLFLOW_TRACKING_PASSWORD="YOUR_PASSWORD"
MLFLOW_EXPERIMENT_NAME="pytorch-training"
MLFLOW_RUN_NAME=""
MLFLOW_LOG_EVERY_N_STEPS=20
MLFLOW_STRICT=false
MLFLOW_ENABLE_ARTIFACTS=true

# Throughput tuning for large NVIDIA GPUs.
SLEEP_BATCH_SIZE=192
SLEEP_NUM_WORKERS=16
SLEEP_PREFETCH_FACTOR=4
SLEEP_PIN_MEMORY=true
SLEEP_USE_AMP=true
SLEEP_AMP_DTYPE=bf16
SLEEP_ALLOW_TF32=true
SLEEP_COMPILE_MODEL=false
SLEEP_COMPILE_MODE=max-autotune
SLEEP_DETERMINISTIC=false
SLEEP_TRAIN_LOG_EVERY_N_STEPS=100
SLEEP_PROGRESS_EVERY_N_STEPS=25
SLEEP_PROGRESS_MIN_INTERVAL=5
